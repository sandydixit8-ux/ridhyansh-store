rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catalog is intentionally public-read so a simple CDN/static-fallback can
    // serve product data. Nothing in products/ contains PII or pricing secrets.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
      match /variants/{variantId} {
        allow read: if true;
        allow write: if false;
      }
    }
    // EVERYTHING else is private. All mutations happen through Cloud Functions
    // (Admin SDK bypasses these rules), so there is no client write path at all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}