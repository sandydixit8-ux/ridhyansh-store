{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "firestore.rules",
      "firestore.indexes.json",
      "firebase.rules.json",
      "CNAME",
      ".git/**",
      ".github/**",
      ".opencode/**",
      "node_modules/**",
      "functions/**",
      "docs/**",
      "README.md",
      "**/*.md"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "region": "asia-south1"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "firebase.rules.json"
  }
}